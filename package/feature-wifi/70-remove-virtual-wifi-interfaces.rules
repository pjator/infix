# Remove kernel-created WiFi interfaces
# All WiFi interfaces are now virtual interfaces created by confd.
# No sysfs conditions here: the add uevent races the creation of the
# phy80211 link, so any TEST/PROGRAM on it can silently skip the rule.
# DEVTYPE is safe -- it comes from the uevent itself (mac80211 sets it
# before netdev registration) and spares the helper for non-WiFi
# interfaces that merely carry a wlan* name.
SUBSYSTEM=="net", ACTION=="add", KERNEL=="wlan*", ENV{DEVTYPE}=="wlan", \
  RUN+="/usr/libexec/infix/wifi-vif-cleanup %k"
